{
  "name": "bank-economics",
  "version": "0.1.0",
  "description": "A UK bank simulation game: run a bank inside a simulated economy of companies and households.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "npm run build && node dist/src/cli.js",
    "ui": "npm run build && node scripts/serve.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
